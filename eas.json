{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "image": "latest" },
      "ios": { "image": "latest" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "main",
      "environment": "production",
      "android": { "image": "latest", "buildType": "apk" },
      "ios": { "image": "latest" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "android": { "image": "latest" },
      "ios": { "image": "latest" }
    }
  },
  "submit": {
    "production": {}
  }
}