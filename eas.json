{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "$MAPBOX_DOWNLOADS_TOKEN"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "main",
      "environment": "production",
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "$MAPBOX_DOWNLOADS_TOKEN"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "$MAPBOX_DOWNLOADS_TOKEN"
      }
    }
  },
  "submit": {
    "production": {}
  }
}