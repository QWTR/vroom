{
  "expo": {
    "name": "vroom",
    "slug": "vroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logotypRed.png",
    "scheme": "vroom",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexuuw.vroom",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logotypRed.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lexuuw.vroom",
      "backgroundColor": "#0a0a0a",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAIViHITDEhTzTsfK_eIhA53PKlAL3dpTw"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/iconVR.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logotypRed.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a",
          "dark": {
            "image": "./assets/images/logotypRed.png",
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0dceda47-6f18-40dc-a736-be4f23c2769f"
      }
    }
  }
}