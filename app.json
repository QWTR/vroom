{
  "expo": {
    "name": "vroom",
    "slug": "vroom",
    "version": "1.0.31",
    "orientation": "portrait",
    "icon": "./assets/images/Frame1933.png",
    "scheme": "vroom",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/3142aa8a-ca54-4d98-8120-657b87a714c3",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.31",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexuuw.vroom.app",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0a0a0a",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.carplay-maps": true
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VROOM używa lokalizacji do mapy, nawigacji i ostrzeżeń drogowych.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "VROOM używa lokalizacji także w tle do liczenia kilometrów, aktywnej nawigacji i udostępniania pozycji live po włączeniu tej funkcji.",
        "NSLocationAlwaysUsageDescription": "VROOM używa lokalizacji w tle podczas aktywnej nawigacji i trybu jazdy, aby niezawodnie naliczać kilometry.",
        "NSCameraUsageDescription": "VROOM używa aparatu do skanowania kodów QR biletów na wydarzeniach.",
        "NSMicrophoneUsageDescription": "VROOM używa mikrofonu tylko podczas aktywnej rozmowy VROOM CB.",
        "NSPhotoLibraryAddUsageDescription": "VROOM zapisuje gotową grafikę story do Twojej galerii zdjęć.",
        "NSPhotoLibraryUsageDescription": "VROOM zapisuje gotową grafikę story do Twojej galerii zdjęć.",
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Frame1933.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.lexuuw.vroom.app",
      "backgroundColor": "#0a0a0a",
      "googleServicesFile": "./google-services.json",
      "config": {},
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/iconVR.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# VROOM: optional Stripe push-provisioning classes\n-dontwarn com.stripe.android.pushProvisioning.**"
          }
        }
      ],
      "./plugins/withCarPlay",
      "./plugins/withAndroidAuto",
      "./plugins/withVroomBgLocationNotification",
      "./plugins/withVroomCbRadio",
      "./plugins/withWiroomBackgroundDrive",
      "./plugins/withVroomMapCameraFollower",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1660420496578702~6160582848",
          "iosAppId": "ca-app-pub-1660420496578702~1840643009"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Frame1933.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a",
          "dark": {
            "image": "./assets/images/Frame1933.png",
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Frame1933.png",
          "color": "#e33835",
          "defaultChannel": "vroom_alerts",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VROOM używa lokalizacji także w tle do liczenia kilometrów, aktywnej nawigacji i udostępniania pozycji live po włączeniu tej funkcji.",
          "locationAlwaysPermission": "VROOM używa lokalizacji w tle, gdy aplikacja jest zamknięta lub nieużywana, aby liczyć kilometry i utrzymać aktywną nawigację.",
          "locationWhenInUsePermission": "VROOM używa lokalizacji do mapy, nawigacji i ostrzeżeń drogowych.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "react-native-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "VROOM używa aparatu do skanowania kodów QR biletów na wydarzeniach."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "VROOM zapisuje gotową grafikę story do Twojej galerii zdjęć.",
          "savePhotosPermission": "VROOM zapisuje gotową grafikę story do Twojej galerii zdjęć.",
          "granularPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3142aa8a-ca54-4d98-8120-657b87a714c3"
      }
    },
    "owner": "vroomapps-organization"
  }
}
