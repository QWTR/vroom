{
  "expo": {
    "name": "vroom",
    "slug": "vroom",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/images/Frame1933.png",
    "scheme": "vroom",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/3142aa8a-ca54-4d98-8120-657b87a714c3",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.11",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexuuw.vroom.app",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0a0a0a",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VROOM potrzebuje lokalizacji do nawigacji i pokazywania innych kierowców.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "VROOM potrzebuje lokalizacji w tle do aktywnej nawigacji.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Frame1933.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.lexuuw.vroom.app",
      "backgroundColor": "#0a0a0a",
      "googleServicesFile": "./google-services.json",
      "config": {},
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/iconVR.png"
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox",
          "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "sk.eyJ1IjoicDFrM3kiLCJhIjoiY21vMXNtY3I2MDZ4MDJycXBlNjE2N3I2NiJ9.Pph6zSTeZtY9IuGaRyHUlg"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1660420496578702~6160582848",
          "iosAppId": "ca-app-pub-1660420496578702~1840643009"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Frame1933.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a",
          "dark": {
            "image": "./assets/images/Frame1933.png",
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Frame1933.png",
          "color": "#e33835",
          "defaultChannel": "vroom_alerts",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VROOM potrzebuje lokalizacji do nawigacji i pokazywania innych kierowców na mapie.",
          "locationAlwaysPermission": "VROOM potrzebuje lokalizacji w tle do aktywnej nawigacji.",
          "locationWhenInUsePermission": "VROOM potrzebuje lokalizacji do nawigacji.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withAutomotive",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3142aa8a-ca54-4d98-8120-657b87a714c3"
      }
    },
    "owner": "vroomapps-organization"
  }
}
