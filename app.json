{
  "expo": {
    "name": "vroom",
    "slug": "vroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logotypRed.png",
    "scheme": "vroom",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/0dceda47-6f18-40dc-a736-be4f23c2769f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexuuw.vroom",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0a0a0a",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VROOM potrzebuje lokalizacji do nawigacji i pokazywania innych kierowców.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "VROOM potrzebuje lokalizacji w tle do aktywnej nawigacji.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logotypRed.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.lexuuw.vroom",
      "backgroundColor": "#0a0a0a",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAIViHITDEhTzTsfK_eIhA53PKlAL3dpTw"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/iconVR.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logotypRed.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a",
          "dark": {
            "image": "./assets/images/logotypRed.png",
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logotypRed.png",
          "color": "#e33835",
          "defaultChannel": "vroom_alerts",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VROOM potrzebuje lokalizacji do nawigacji i pokazywania innych kierowców na mapie.",
          "locationAlwaysPermission": "VROOM potrzebuje lokalizacji w tle do aktywnej nawigacji.",
          "locationWhenInUsePermission": "VROOM potrzebuje lokalizacji do nawigacji.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0dceda47-6f18-40dc-a736-be4f23c2769f"
      }
    },
    "owner": "lexuuw"
  }
}